# Copy to .env and add your own values. Keep .env private.
DISCORD_BOT_TOKEN=
# Optional: server to feature in the homepage snapshot.
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=
# Optional: default points at the configured VPS HTTPS status endpoint.
BOT_STATUS_API_URL=https://82-26-104-147.sslip.io/health
# Optional only if your reverse proxy requires authentication from Vercel.
BOT_STATUS_SECRET=
PORT=3000
# Discord Developer Portal > OAuth2. Never put secrets in public files.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
APP_URL=http://localhost:3000
# At least 32 random characters; changing this invalidates existing logins.
SESSION_SECRET=
# Comma-separated Discord user IDs; profile cards and CMS access use this list.
OWNER_IDS=
# Persistent dashboard API hosted alongside the PUBLIC bot, not Vercel storage.
BOT_DASHBOARD_API_URL=http://127.0.0.1:8788/dashboard
BOT_DASHBOARD_SECRET=
